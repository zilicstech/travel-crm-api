# Copy to .env and fill in real values. .env is git-ignored.

DB_URL=jdbc:postgresql://localhost:5432/voyra_crm_dev
DB_USERNAME=voyra
DB_PASSWORD=

# openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# openssl rand -base64 32 (separate key from JWT_SECRET)
PASSWORD_ENCRYPTION_KEY=

STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_DIR=./uploads

PUBLIC_PROPOSAL_BASE_URL=http://localhost:3000/proposal
PUBLIC_PROPOSAL_VALIDITY_DAYS=90

SERVER_PORT=8080

# LOCAL ONLY - seeds a demo agency/owner/agent with a known password. Never true in a deployed env.
SEED_DEMO_DATA=true

# Safe for every environment, including production. Idempotent - seeds one SUPER_ADMIN account
# once, then does nothing on subsequent boots. Leave both unset to skip entirely.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=DEBUG

# --- Deployment only (Cloud Run) ---
# SPRING_PROFILES_ACTIVE=cloudrun
# RUN_TENANT_MIGRATIONS=true
