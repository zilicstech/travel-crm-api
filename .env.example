# Copy to .env and fill in real values. .env is git-ignored.

DB_URL=jdbc:postgresql://localhost:5432/voyra_crm_dev
DB_USERNAME=voyra
DB_PASSWORD=

# openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# openssl rand -base64 32 (separate key from JWT_SECRET)
PASSWORD_ENCRYPTION_KEY=

STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_DIR=./uploads

# Used only when STORAGE_PROVIDER=gcs
GCS_BUCKET=
GCS_OBJECT_PREFIX=
GCP_PROJECT_ID=
GCP_CREDENTIALS_FILE=

PUBLIC_PROPOSAL_BASE_URL=http://localhost:3000/proposal
PUBLIC_PROPOSAL_VALIDITY_DAYS=90

SERVER_PORT=8080

# LOCAL ONLY - seeds a demo agency/owner/agent with a known password. Never true in a deployed env.
SEED_DEMO_DATA=true

# Safe for every environment, including production. Idempotent - seeds one SUPER_ADMIN account
# once, then does nothing on subsequent boots. Leave both unset to skip entirely.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Supplier search - "mock" (default) generates fake offers; "tripjack" switches every agency
# over to real Tripjack search using that agency's own credentials (Settings > Supplier).
FLIGHT_SUPPLIER=mock
HOTEL_SUPPLIER=mock

CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=DEBUG

# Nightly job that moves deferred revenue (2120 Unearned Tour Revenue) to Sales once a
# booking's departure date has arrived. In an autoscaled deployment, set this false on every
# instance but one - a second instance running it concurrently is harmless (idempotent on the
# journal's own existence) but wasteful, not incorrect.
REVENUE_RECOGNITION_ENABLED=true
# REVENUE_RECOGNITION_CRON=0 30 1 * * *

# --- Deployment only (Cloud Run) ---
# SPRING_PROFILES_ACTIVE=cloudrun
# RUN_TENANT_MIGRATIONS=true
